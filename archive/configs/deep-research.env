# File: configs/deep-research.env

# Application
APP_NAME="deep-research-web-ui"
APP_DIR="/opt/deep-research-web-ui"
APP_USER="deepresearch"
APP_PORT=3000
RELEASE_TAG="v1.2.0"
REPO_URL="https://github.com/AnotiaWang/deep-research-web-ui.git"
NODE_MAJOR=22

# Container Network & IDs
CT_ID=180
CT_HOSTNAME="deepresearch"
CT_IP="10.0.0.180"
CT_IP_CIDR="10.0.0.180/24"
CT_GW="10.0.0.254"
CT_DNS="1.1.1.1 8.8.8.8"
CT_BRIDGE="vmbr1"

# Container Resources
CT_STORAGE="local"
CT_DISK="20"
CT_MEM=4096
CT_SWAP=2048
CT_CORES=2

# Paths
SNIPPET_DIR="/var/lib/vz/snippets"
HEARTBEAT_DIR="/root/heartbeats"